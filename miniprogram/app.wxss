/* 全局样式：智能课表 */
page {
  background: #f2f4f8;
  color: #1c2333;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}

.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 40, 90, 0.06);
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #8a93a6;
}

/* ---------- 布局 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.gap8 { gap: 8rpx; }
.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }

.mt8 { margin-top: 8rpx; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }

/* ---------- 文本 ---------- */
.muted { color: #8a93a6; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; }
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #3b6bff, #2b5cff);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: #eef2ff;
  color: #2b5cff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-ghost::after { border: none; }

.btn-plain {
  background: #f2f4f8;
  color: #46506b;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-plain::after { border: none; }

.btn-mini {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #eef2ff;
  color: #2b5cff;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}
.tag-gray { background: #f2f4f8; color: #6b7385; }
.tag-green { background: #e6f9f1; color: #0ca678; }
.tag-orange { background: #fff2e6; color: #f76707; }
.tag-red { background: #ffecef; color: #e03131; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #a3aab9;
  font-size: 26rpx;
}

/* ---------- 通用小控件 ---------- */
.divider {
  height: 1rpx;
  background: #eef0f5;
  margin: 20rpx 0;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex: none;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f4f8;
  color: #46506b;
  font-size: 26rpx;
  margin: 0 14rpx 14rpx 0;
  display: inline-block;
}
.chip.active {
  background: #2b5cff;
  color: #fff;
}

.scroll-x {
  white-space: nowrap;
}
