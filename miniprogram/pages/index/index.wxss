/* ============ 顶部主卡 ============ */
.hero {
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #3b6bff 0%, #2b5cff 55%, #1f47db 100%);
  box-shadow: 0 10rpx 30rpx rgba(43, 92, 255, 0.28);
}
.hero-during {
  background: linear-gradient(135deg, #12b886 0%, #0ca678 60%, #099268 100%);
  box-shadow: 0 10rpx 30rpx rgba(12, 166, 120, 0.28);
}
.hero-idle {
  background: linear-gradient(135deg, #6b7385 0%, #4d566b 100%);
  box-shadow: 0 10rpx 30rpx rgba(77, 86, 107, 0.22);
}

.hero-top {
  opacity: 0.85;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.hero-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-countdown {
  font-size: 78rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  margin: 6rpx 0 12rpx;
}

.hero-course {
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.hero-meta {
  font-size: 24rpx;
  opacity: 0.92;
}

.hero-room {
  font-size: 26rpx;
  margin-top: 10rpx;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.hero-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}
.hero-btn:active {
  background: rgba(255, 255, 255, 0.34);
}

/* ============ 自习教室推荐 ============ */
.room-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.room-line:last-child { border-bottom: none; }
.room-line-main { flex: 1; min-width: 0; }

/* ============ 今日时间轴 ============ */
.tl-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.tl-item:last-child { border-bottom: none; }

.tl-time {
  width: 96rpx;
  flex: none;
  text-align: left;
}
.tl-start { font-size: 26rpx; font-weight: 600; color: #1c2333; }
.tl-end { font-size: 20rpx; color: #a3aab9; }

.tl-bar {
  width: 8rpx;
  height: 68rpx;
  border-radius: 8rpx;
  margin: 0 20rpx 0 4rpx;
  flex: none;
}

.tl-item .tiny { margin-top: 4rpx; }

.tl-status {
  flex: none;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f4f8;
  color: #8a93a6;
}
.tl-status-ongoing { background: #e6f9f1; color: #0ca678; }
.tl-status-soon { background: #fff2e6; color: #f76707; }
.tl-status-upcoming { background: #eef2ff; color: #2b5cff; }

.tl-item.tl-done { opacity: 0.5; }

/* ============ 空堂 ============ */
.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.slot-row:last-child { border-bottom: none; }

/* ============ 提醒弹层 ============ */
.alert-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(16, 22, 38, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.alert-box {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 44rpx 36rpx 36rpx;
  text-align: center;
  animation: pop 0.22s ease-out;
}
.alert-urgent {
  border: 4rpx solid #ff6b6b;
}

@keyframes pop {
  from { transform: scale(0.88); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.alert-icon {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.alert-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.alert-urgent .alert-title { color: #e03131; }

.alert-content {
  font-size: 28rpx;
  color: #46506b;
  line-height: 1.7;
  white-space: pre-line;
  text-align: left;
  background: #f7f8fc;
  border-radius: 20rpx;
  padding: 24rpx;
}
