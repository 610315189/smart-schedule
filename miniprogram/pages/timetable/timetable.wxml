<view class="page">

  <!-- ============ 周次切换 ============ -->
  <view class="card card-tight">
    <view class="row-between">
      <view class="nav-btn" bindtap="prevWeek">‹ 上周</view>
      <picker mode="selector" range="{{weekOptions}}" value="{{weekIndex}}" bindchange="onWeekPick">
        <view class="week-title">{{weekLabel}}</view>
      </picker>
      <view class="nav-btn" bindtap="nextWeek">下周 ›</view>
    </view>
    <view class="row mt16">
      <view class="chip {{showWeekend ? '' : 'active'}}" bindtap="toggleWeekend">只看周一~周五</view>
      <view class="chip" bindtap="backToNow">回到本周</view>
    </view>
  </view>

  <view class="warn" wx:if="{{conflictText}}">⚠️ {{conflictText}}</view>

  <!-- ============ 课表网格 ============ -->
  <view class="card grid-card">
    <view class="grid-head">
      <view class="corner"></view>
      <view
        class="head-day {{item.isToday ? 'head-today' : ''}}"
        wx:for="{{days}}"
        wx:key="day"
        style="width:{{item.width}}rpx"
      >
        <view class="hd-name">{{item.weekName}}</view>
        <view class="hd-date">{{item.dateLabel}}</view>
      </view>
    </view>

    <view class="grid-body" style="height:{{bodyHeight}}rpx">
      <view class="period-col">
        <view class="period-cell" wx:for="{{rows}}" wx:key="period" style="height:{{rowHeight}}rpx">
          <view class="p-no">{{item.period}}</view>
          <view class="p-time">{{item.start}}</view>
        </view>
      </view>

      <view class="day-area">
        <view class="h-line" wx:for="{{rows}}" wx:key="period" style="top:{{item.top}}rpx"></view>

        <view
          class="cell"
          wx:for="{{cells}}"
          wx:key="key"
          style="{{item.style}}"
          data-day="{{item.day}}"
          data-period="{{item.period}}"
          bindtap="onCellTap"
        ></view>

        <view
          class="block"
          wx:for="{{blocks}}"
          wx:key="key"
          style="{{item.style}}"
          data-id="{{item.id}}"
          bindtap="onBlockTap"
        >
          <view class="block-name">{{item.name}}</view>
          <view class="block-room">{{item.room}}</view>
        </view>

        <view class="now-line" wx:if="{{nowLine >= 0}}" style="top:{{nowLine}}rpx"></view>
      </view>
    </view>
  </view>

  <view class="legend tiny muted">
    点击空白格 → 查看该时段有哪些空教室；点击课程块 → 查看课程详情。
  </view>

</view>

<!-- ============ 详情弹层 ============ -->
<view class="mask" wx:if="{{sheet.show}}" catchtouchmove="noop" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{sheet.title}}</view>
    <view class="sheet-sub">{{sheet.subtitle}}</view>

    <block wx:if="{{sheet.type === 'course'}}">
      <view class="sheet-line" wx:for="{{sheet.lines}}" wx:key="*this">{{item}}</view>
      <view class="row gap16 mt24">
        <view class="btn-plain flex1" bindtap="closeSheet">关闭</view>
        <view class="btn-primary flex1" bindtap="editCourse">编辑课程</view>
      </view>
    </block>

    <block wx:if="{{sheet.type === 'rooms'}}">
      <view wx:if="{{sheet.empty}}" class="empty">该时段没有可自习的空教室</view>
      <view class="room-row" wx:for="{{sheet.rooms}}" wx:key="name">
        <view class="flex1">
          <view class="strong">{{item.name}}</view>
          <view class="tiny muted">{{item.building}} · {{item.capacity}} 座</view>
        </view>
        <view class="tag tag-green">{{item.freeSpanText}}</view>
      </view>
      <view class="row gap16 mt24">
        <view class="btn-plain flex1" bindtap="closeSheet">关闭</view>
        <view class="btn-primary flex1" bindtap="gotoClassroom">空教室查询</view>
      </view>
    </block>
  </view>
</view>
