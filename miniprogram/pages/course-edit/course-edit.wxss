/* ============ 顶部 tab ============ */
.tabs {
  display: flex;
  background: #e9edf5;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7385;
  border-radius: 999rpx;
}
.tab.active {
  background: #fff;
  color: #2b5cff;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(20, 40, 90, 0.08);
}

.warn {
  background: #fff2e6;
  color: #d9480f;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

/* ============ 课程行 ============ */
.course-line {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.course-line:last-child { border-bottom: none; }

.color-dot {
  width: 12rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex: none;
}

.del-btn {
  flex: none;
  font-size: 24rpx;
  color: #e03131;
  padding: 12rpx 20rpx;
  background: #ffecef;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.legend {
  text-align: center;
  margin: 8rpx 0 24rpx;
}

/* ============ 悬浮按钮 ============ */
.fab {
  position: fixed;
  right: 44rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b6bff, #2b5cff);
  color: #fff;
  font-size: 56rpx;
  line-height: 108rpx;
  text-align: center;
  box-shadow: 0 10rpx 28rpx rgba(43, 92, 255, 0.4);
  z-index: 50;
}
.fab:active { opacity: 0.85; }

/* ============ 导入 ============ */
.import-area {
  width: 100%;
  min-height: 300rpx;
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  line-height: 1.6;
}

.import-msg {
  background: #eef2ff;
  color: #2b5cff;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
  white-space: pre-line;
  margin-bottom: 16rpx;
}

/* 文件信息与解析结果 */
.file-box {
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #eef0f5;
}

.msg {
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
  white-space: pre-line;
}
.msg-ok {
  background: #e6f9f1;
  color: #0b7a5b;
}
.msg-error {
  background: #ffecef;
  color: #c92a2a;
}

.warn-text {
  color: #d9480f;
  margin-top: 4rpx;
}

/* 教室字典补充提示 */
.room-fix {
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.pv-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f8;
}
.pv-row:last-child { border-bottom: none; }

/* ============ 表单弹层 ============ */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(16, 22, 38, 0.5);
  z-index: 900;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx 60rpx;
  box-sizing: border-box;
  max-height: 88vh;
  overflow-y: auto;
  animation: slideUp 0.2s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(60rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.f-label {
  font-size: 24rpx;
  color: #8a93a6;
  margin: 20rpx 0 10rpx;
}

.f-input {
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  font-size: 28rpx;
}

.f-pick {
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
}

.f-row {
  display: flex;
  gap: 20rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

.color-row {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
}

.color-item {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-sizing: border-box;
}
.color-item.sel {
  border: 6rpx solid #1c2333;
}
