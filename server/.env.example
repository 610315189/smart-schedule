# 复制本文件为 .env 后填写真实值
# cp .env.example .env

# 服务端口
PORT=3000

# 微信小程序 AppID / AppSecret（公众平台-开发管理-开发设置）
WX_APPID=
WX_SECRET=

# 订阅消息模板 ID（公众平台-订阅消息-我的模板）
WX_TEMPLATE_ID=

# 点击通知后打开的小程序页面
WX_PUSH_PAGE=pages/index/index

# 模板字段名映射：按你自己申请到的模板字段改
# 例如模板内容为「课程名称 {{thing1.DATA}} / 上课时间 {{time2.DATA}} / 教室 {{thing3.DATA}} / 提示 {{thing4.DATA}}」
TF_COURSE=thing1
TF_TIME=time2
TF_ROOM=thing3
TF_TIP=thing4

# 扫描间隔（毫秒）
SCAN_INTERVAL_MS=30000

# 时区偏移（小时），中国大陆为 8
TZ_OFFSET_HOURS=8

# 是否额外发送"最后提醒"
FINAL_PUSH=false

# 开发模式：不校验微信 code，用 code 直接当 openid（仅本地调试用）
DEV_MODE=false
